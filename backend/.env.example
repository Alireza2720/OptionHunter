# ============================================================
# Option Hunter - Environment Variables
# ============================================================

# ---- MongoDB ----
MONGO_URI=mongodb://optionhunter:YOUR_PASSWORD@127.0.0.1:27017/trading_bot?authSource=trading_bot

# ---- AlgoTik Collector (جایگزین BrsApi) ----
ALGOTIK_URL=http://127.0.0.1:5000

# ---- Server ----
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# ---- Admin Auth ----
# برای کار با UI، این توکن رو در مرورگر وارد کن
ADMIN_TOKEN=

# ---- Telegram / Bale ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
# برای بله:
# TELEGRAM_API_BASE=https://tapi.bale.ai

# ---- Options Chain API ----
OPTIONS_API_URL=https://s3.optionschool24.com/last?type=3

# ---- Trading Window ----
ENTRY_START=09:30
ENTRY_END=12:00

# ---- Fees ----
OPTION_FEE_BUY=0.0012
OPTION_FEE_SELL=0.0012
RISK_FREE_RATE=0.23