# ============================================================
# Option Hunter — Environment Variables (Example)
# ============================================================

# ---- MongoDB ----
MONGO_URI=mongodb://optionhunter:YOUR_PASSWORD@127.0.0.1:27017/trading_bot?authSource=trading_bot

# ---- AlgoTik / Collector ----
ALGOTIK_URL=http://127.0.0.1:5000

# ---- Pricing Model ----
# bsm    = Black-Scholes (default, standard)
# heston = Heston stochastic volatility (advanced)
PRICING_MODEL=bsm

# ---- Legacy fallback (Phase 2 — DISABLED) ----
# The collector handles TSETMC. Do NOT set OPTIONS_API_URL;
# it was removed in Phase 2 because it overrode COLLECTOR_URL.
# OPTIONS_API_URL=

# ---- Server ----
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# ---- Admin Auth ----
ADMIN_TOKEN=

# ---- Telegram / Bale ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# ---- Trading ----
ENTRY_START=09:30
ENTRY_END=12:00
OPTION_FEE_BUY=0.0012
OPTION_FEE_SELL=0.0012
RISK_FREE_RATE=0.23

# ---- Signal Filter (اختیاری) ----
# SIGNAL_FILTER_ENABLED=1